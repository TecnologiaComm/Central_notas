# Microsoft Graph (Outlook)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
CAIXA_NOTAS=prestacaocontasti@commcenter.com.br
PASTA_ENTRADA=Inbox
PASTA_PROCESSADOS=Notas Processadas

# App
URL_BASE=https://central-notas-comm.azurewebsites.net
SEGREDO_APP=troque-por-um-valor-longo-e-aleatorio
# Banco, arquivos e carga da planilha ficam aqui (Azure: /home/data)
PASTA_DADOS=./data
# PASTA_ARQUIVOS=\\servidor\financeiro\notas   (padrão: <PASTA_DADOS>/arquivos)
# DATABASE_URL=postgresql+psycopg://...           (padrão: SQLite em <PASTA_DADOS>/notas.db)
INTERVALO_VERIFICACAO_MIN=5
MODO_DEMO=false

# Login Microsoft (só atrás do Azure App Service com autenticação ligada)
LOGIN_OBRIGATORIO=false
USUARIOS_PERMITIDOS=

# SharePoint (vazio = não copia)
SHAREPOINT_SITE=
SHAREPOINT_BIBLIOTECA=Documentos
SHAREPOINT_PASTA=Notas

# IA opcional para PDFs sem XML
ANTHROPIC_API_KEY=

# Protheus (fase 2) — ver protheus/CENTRALNOTAS.tlpp e config/protheus.yaml
PROTHEUS_URL=
PROTHEUS_ENDPOINT=/centralnotas/v1/documento-entrada
PROTHEUS_AUTH=basic
PROTHEUS_USUARIO=
PROTHEUS_SENHA=
PROTHEUS_TIMEOUT_S=120
PROTHEUS_VERIFICAR_TLS=true
PROTHEUS_LANCAR_AUTOMATICO=false
